r_dir_file(init, sysfs_batteryinfo)
allow init sysfs_power_supply:file { setattr };
get_prop(init, vendor_mot_prop)
set_prop(init, vendor_mot_prop)

allow init mnt_product_file:dir mounton;
allow init functionfs:dir mounton;

# Silence harmless execution attempts
dontaudit init vendor_file:file { execute execute_no_trans };
dontaudit init same_process_hal_file:file { execute execute_no_trans };
dontaudit init socket_device:sock_file { create setattr };
dontaudit init sysfs:file { open write };
dontaudit init socket_device:sock_file unlink;
dontaudit init servicemanager:binder { call transfer };
