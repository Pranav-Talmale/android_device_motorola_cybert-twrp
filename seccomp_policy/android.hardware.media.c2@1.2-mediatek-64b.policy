# Policy for android.hardware.media.c2@1.2-mediatek-64b
# Combined from mediacodec.policy and android.hardware.media.c2@1.2-mediatek-seccomp-policy
# Plus missing syscalls: fstatat64, ugetrlimit, sigreturn

# From mediacodec.policy
getpid: 1
gettid: 1
sendto: 1
pselect6: 1
sched_getparam: 1
sched_getscheduler: 1
mlock: 1
munlock: 1
recvfrom: 1
sched_getaffinity: 1
sched_setaffinity: 1
flock: 1
fchownat: 1
fchmodat: 1
fsync: 1
sysinfo: 1
setsockopt: 1
setrlimit: 1
eventfd2: 1
unlinkat: 1

# From android.hardware.media.c2@1.2-mediatek-seccomp-policy
futex: 1
ioctl: 1
sched_yield: 1
close: 1
dup: 1
ppoll: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
# mmap: redefined below as permissive
getuid: 1
getrlimit: 1
fstat: 1
newfstatat: 1
fstatfs: 1
memfd_create: 1
ftruncate: 1
mremap: arg3 == 3 || arg3 == MREMAP_MAYMOVE
munmap: 1
prctl: 1
writev: 1
sigaltstack: 1
clone: 1
exit: 1
lseek: 1
rt_sigprocmask: 1
openat: 1
write: 1
nanosleep: 1
setpriority: 1
set_tid_address: 1
getdents64: 1
readlinkat: 1
read: 1
pread64: 1
gettimeofday: 1
faccessat: 1
exit_group: 1
restart_syscall: 1
rt_sigreturn: 1
getrandom: 1
madvise: 1
# sched_setaffinity: 1 # duplicate
# sched_getaffinity: 1 # duplicate
# sched_getparam: 1 # duplicate
# sched_getscheduler: 1 # duplicate
# recvfrom: 1 # duplicate

# Crash dump policy additions (often found in mediatek policies)
clock_gettime: 1
pipe2: 1
recvmsg: 1
process_vm_readv: 1
tgkill: 1
rt_sigaction: 1
rt_tgsigqueueinfo: 1
geteuid: 1
getgid: 1
getegid: 1
getgroups: 1
sched_setscheduler: 1
mkdirat: 1

# Critical Fixes for SIGSYS
fstatat64: 1
ugetrlimit: 1
sigreturn: 1
mmap: 1
