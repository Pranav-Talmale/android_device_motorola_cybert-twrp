# Camera
persist.vendor.camera.privapp.list=org.lineageos.aperture,com.motorola.camera5
vendor.camera.aux.packagelist=org.lineageos.aperture,com.motorola.camera5

# Display
sys.brightness.disable_gamma_conversion=true

# Moved from vendor.prop to satisfy Treble
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
media.c2.dmabuf.padding=3072
persist.radio.multisim.config=dsds
persist.rcs.supported=1
persist.sys.ams_ext_enabled=true
persist.vendor.mtk_rcs_single_reg_support=0
masterclear.allow_retain_esim_profiles_after_fdr=true
persist.vendor.mtk_rcs_ua_support=1
persist.vendor.mtk_uce_support=0
persist.vendor.vt.RTPInfo=1
persist.vendor.vt.supported=1
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
ro.config.vc_call_vol_steps=8
bluetooth.device.class_of_device=90,2,12
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=true
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.map.server.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true
bluetooth.profile.pbap.server.enabled?=true
bluetooth.profile.sap.server.enabled?=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
camera.disable_zsl_mode=1
drm.service.enabled=true
persist.sys.fuse.passthrough.enable=true
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec=4
debug.stagefright.omx_default_rank=1000
telephony.active_modems.max_count=2
ril.subscription.types=RUIM
ro.telephony.iwlan_operation_mode=AP-assisted
ro.telephony.default_network=26,26
persist.sys.sf.native_mode=300
zygote.critical_window.minute=10
